OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── HeyGen (Avatar V presenter — full-script talking-head videos) ────────────
# API key: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your-heygen-api-key-here
HEYGEN_VOICE_ID=your-voice-id-here

# Avatar look IDs live in config/avatars.json (copy from config/avatars.example.json).
# Optional legacy fallback if avatars.json is empty:
# HEYGEN_AVATAR_IDS=id1,id2,id3,id4,id5

# Optional HeyGen overrides:
# HEYGEN_ENGINE=avatar_v
# HEYGEN_ENGINE_FALLBACK=avatar_iv
# HEYGEN_RESOLUTION=720p
# HEYGEN_ASPECT_RATIO=9:16
# HEYGEN_EXPRESSIVENESS=high
# HEYGEN_VOICE_SPEED=0.95
# HEYGEN_POLL_INTERVAL_SEC=15
# HEYGEN_AVATARS_CONFIG=config/avatars.json
